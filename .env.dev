# To override these variables, create a .env file containing the overrides.

# Services we should configure in this UI.
HUBS_CONFIGURABLE_SERVICES="janus-gateway,reticulum,hubs,spoke"

# The Ita service, for configuration schemas and updates. (In the future this
# will probably be proxied through Reticulum.)
HUBS_ITA_SERVER="turkey"

# The Reticulum backend to connect to. Used for storing information about active hubs.
# See here for the server code: https://github.com/Hubs-Foundation/reticulum
HUBS_RETICULUM_SERVER="https://hubs.local:4000"

# PostgREST server configured to allow administrative access to the db.
#HUBS_POSTGREST_SERVER="https://hubs.local:3000"

HUBS_HOST="hubs.local"
HUBS_RETICULUM_SOCKET_SERVER="hubs.local",
HUBS_CORS_PROXY_SERVER="hubs-proxy.local:4000"
HUBS_NON_CORS_PROXY_DOMAINS="hubs.local"
HUBS_BASE_ASSETS_PATH="https://hubs.local:8989/"